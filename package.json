{
  "name": "dust-gtm-handoff-reliability-desk",
  "version": "0.1.0",
  "private": true,
  "description": "GTM Handoff Reliability Desk: independent concept by Ayo Ahmed (not affiliated with Dust). Synthetic data only.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/ui/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap=linked --outfile=public/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "axe-core": "^4.10.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
